      \field{sortinithash}{23a3aa7c24e56cfa16945d55545109b5}
      \field{labelnamesource}{author}
      \field{labeltitlesource}{title}
      \field{abstract}{It is known that the famous theoretical formula by Koiter for the critical buckling load of circular cylindrical shells under axial compression does not coincide with the experimental data. Namely, while Koiter’s formula predicts linear dependence of the buckling load $\lambda(h)$ on the shell thickness $h$, experiments show $\lambda(h)\sim h^{3/2}$. This discrepancy is attributed to sensitivity to imperfections. Prior work showed load twist leads to $\lambda(h)\sim h^{5/4}$, while shape imperfections yield $\lambda(h)\sim h^{3/2}$. In this work, we prove that the buckling load depends on cross-sectional curvature. For uniformly positive curvature, $\lambda(h)\sim h$, and when curvature vanishes at finitely many points, $C_1 h^{8/5} \le \lambda(h) \le C_2 h^{3/2}$ for small $h$.}
      \field{issn}{1432-1467}
      \field{journaltitle}{Journal of Nonlinear Science}
      \field{number}{2}
      \field{title}{The Buckling Load of Cylindrical Shells Under Axial Compression Depends on the Cross-Sectional Curvature}
      \field{volume}{33}
      \field{year}{2023}
      \field{pages}{27}
